# Fol Bazar — static export SPA fallback for Apache / cPanel.
# Keep this file in the same directory as index.html (Next.js copies public/
# into the export root).

DirectoryIndex index.html
Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Existing files/folders (_next, CSS, JS, images, uploads, etc.) must load
  # normally. Everything else is a client-side route.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # IMPORTANT: product detail pages are SPA routes. On a hard refresh such as
  # /product/mango-premium/ Apache must serve the app shell instead of 404.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
