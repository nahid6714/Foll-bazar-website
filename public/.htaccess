# Fol Bazar — static export hosting config for Apache / cPanel shared hosting.
# This file is copied into the exported "out" folder automatically by
# `next build` (everything under public/ gets copied to the export root).

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Real files and folders (css, js, _next assets, images, etc.) load as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else — /product/some-slug, /cart, /track-order, a hard
  # refresh on any in-app page, etc. — falls back to the same app shell.
  # The app reads window.location on load and shows the right screen.
  RewriteRule ^ /index.html [L]
</IfModule>

# Cache hashed build assets aggressively; HTML stays revalidated.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Basic compression for faster loads on shared hosting.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
